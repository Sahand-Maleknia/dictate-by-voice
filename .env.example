# Get a free key at https://aistudio.google.com/apikey
# The audio never touches any other service: it goes from your machine straight
# to this API and only the text comes back.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional overrides
# DICTATE_MIC=2              # force an input device (the CLI prints the list)
# DICTATE_MAX_SECONDS=600    # hard cap on one recording
# DICTATE_KEEP_LAST=0        # delete the audio immediately (disables --again)
